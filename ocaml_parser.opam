opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/janestreet/ocaml_parser"
bug-reports: "https://github.com/janestreet/ocaml_parser/issues"
dev-repo: "git+https://github.com/janestreet/ocaml_parser.git"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/ocaml_parser/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.2.0"}
  "base"
  "bin_prot"
  "ppx_jane"
  "ppxlib_jane"
  "dune"                {>= "3.17.0"}
  "ocaml-compiler-libs" {>= "v0.11.0"}
  "ppxlib"              {>= "0.39.0"}
]
available: arch != "x86_32"
conflicts: [
  "oxcaml-compiler" {< "5.2.0minus39"}
]
synopsis: "OCaml parsing library"
description: "
Ocaml_parser provides a small interface for parsing OCaml source code and working with parsed OCaml AST fragments.
"
